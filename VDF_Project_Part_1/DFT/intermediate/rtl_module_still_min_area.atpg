Procedures {
    "load_unload" {
        W "_default_WFT_";
        V {
          "clk"=0; 
          "scan_en"=1; 
          }
        Shift {
          W "_default_WFT_";
          V {
         "_si"=##; "_so"=##;
            "clk"=P; 
            "scan_en"=1; 
}
        }
    }
    "capture" {
        W "_default_WFT_";
        F { 
          }
        V { "_pi"=\r15 #; "_po"=\r14 #; }
    }
    "capture_clk" {
        W "_default_WFT_";
        F { 
        }
        "forcePI": V { "_pi"=\r15 #; }
        "measurePO": V { "_po"=\r14 #; }
        "pulse": V { "clk"=P; }
    }
}
MacroDefs {
    "test_setup" {
        W "_default_WFT_";
        V { 
            "clk" =0; 
           }
      // If required, add your test_controller specific initilization vectors here
        V { 
