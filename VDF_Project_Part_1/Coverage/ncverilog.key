database -open waves -into waves.shm -default
probe -create -shm tb_toll_gate.barrier_close_cmd tb_toll_gate.barrier_open_cmd tb_toll_gate.clk tb_toll_gate.display_out tb_toll_gate.i tb_toll_gate.led_status tb_toll_gate.reset tb_toll_gate.sensor_vehicle_enter tb_toll_gate.sensor_vehicle_exit tb_toll_gate.vehicle_id_in
run
coverage -analyze
exit
